<?xml version="1.0" encoding="utf-8"?>
<Map background-color="#00000000" srs="+proj=merc +a=6378137 +b=6378137 +lat_ts=0.0 +lon_0=0.0 +x_0=0.0 +y_0=0 +k=1.0 +units=m +nadgrids=@null +wktext +no_defs +over">

  <!-- Natural Earth Rivers Layer Style (z0-5) -->
  <!-- River and lake centerlines, in the same pure blue (#0000FF) as -->
  <!-- layers/rivers.xml so the mask extraction downstream is unchanged. -->
  <!-- -->
  <!-- stroke-width matches layers/rivers.xml deliberately. These are world-scale -->
  <!-- rivers on a 256px tile, so the line is already at the limit of what the -->
  <!-- watercolor blur can hold; widening it here would make the low zooms look -->
  <!-- like a different map rather than the same map further out. -->

  <Style name="rivers">
    <Rule>
      <LineSymbolizer stroke="#0000FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" clip="false" />
    </Rule>
  </Style>

  <!-- Data Layers -->
  <!-- The shape plugin instead of ogr+GeoJSON: below z6 the features come from -->
  <!-- a shapefile, not from Overpass. The layer srs is unchanged from -->
  <!-- layers/rivers.xml, since Natural Earth ships in EPSG:4326. -->
  <Layer name="rivers" srs="+proj=longlat +datum=WGS84 +no_defs">
    <StyleName>rivers</StyleName>
    <Datasource>
      <Parameter name="type">shape</Parameter>
      <Parameter name="file">DATASOURCE_PLACEHOLDER</Parameter>
    </Datasource>
  </Layer>

</Map>
